{
  "name": "done-coding-schema",
  "version": "0.0.0",
  "description": "跨前后端通用接口结构的唯一来源：JSON Schema 定义，生成并发布各语言契约包",
  "private": true,
  "workspaces": [
    "packages/**",
    "!**/uni_modules/**"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky install",
    "postinstall": "prettier --write ./pnpm-lock.yaml",
    "log": "conventional-changelog -p angular -i CHANGELOG.md -s --release-count 0",
    "check:examples": "node scripts/check-examples.mjs"
  },
  "author": "JustSoSu",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^16.3.0",
    "@commitlint/config-conventional": "^16.2.4",
    "@ls-lint/ls-lint": "^2.2.3",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "ajv": "8.20.0",
    "conventional-changelog": "^5.1.0",
    "conventional-changelog-cli": "^4.1.0",
    "eslint": "^8.49.0",
    "eslint-config-alloy": "^5.1.2",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-regexp": "^2.7.0",
    "eslint-plugin-vue": "^9.25.0",
    "husky": "^8.0.3",
    "json-schema-to-typescript": "16.0.0",
    "lerna": "^7.3.0",
    "lint-staged": "^12.5.0",
    "prettier": "^3.0.3",
    "typescript": "^5.8.3",
    "vue-eslint-parser": "^9.4.2"
  },
  "lint-staged": {
    "packages/**/src/*": [
      "ls-lint"
    ],
    "*.{ts,js,vue,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/{src,tests}/**/*.py": [
      "uvx --from 'ruff==0.16.9' ruff check --fix",
      "uvx --from 'ruff==0.16.9' ruff format"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
